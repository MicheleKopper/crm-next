generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String   @map("full_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  /// Mirrors the legacy JWT `permissions[0]` shape, e.g. { customers_create, customers_edit, customers_delete }
  permissions  Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  ownedCompanies  Company[]        @relation("CompanyOwner")
  operatedLeads   Lead[]           @relation("LeadOperator")
  productsPo      ProductPo[]
  dashboardLayout DashboardLayout?

  @@map("users")
}

model Company {
  id           String   @id @default(uuid()) @db.Uuid
  displayName  String   @map("display_name")
  legalName    String   @map("legal_name")
  taxId        String   @unique @map("tax_id")
  foreignValue Boolean  @default(false) @map("foreign_value")
  /// Nullable: leads created without a company phone (only Customers collect it today)
  phone        String?  @unique
  website      String?
  address1     String?
  number       String?
  address2     String?
  city         String?
  state        String?
  country      String?
  postalCode   String?  @map("postal_code")
  /// Entity types this company record represents, e.g. ["Customer"]
  companyType  Json     @map("company_type")
  ownerId      String?  @map("owner_id") @db.Uuid
  owner        User?    @relation("CompanyOwner", fields: [ownerId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customerProfile CustomerProfile?
  leads           Lead[]
  contacts        Contact[]

  flexitankLocations      Flexitank[]      @relation("FlexitankLocation")
  shipmentsAsCustomer     Shipment[]       @relation("ShipmentCustomer")
  shipmentsAsShipper      Shipment[]       @relation("ShipmentShipper")
  shipmentsAsConsignee    Shipment[]       @relation("ShipmentConsignee")
  shipmentsAsShippingLine Shipment[]       @relation("ShipmentShippingLine")
  flexitankDepots         FlexitankDepot[]
  quotes                  Quote[]

  @@map("companies")
}

/// Minimal quote record — only enough to power the dashboard's "Potencial" customer bucket.
model Quote {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String?  @map("customer_id") @db.Uuid
  customer   Company? @relation(fields: [customerId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("quotes")
}

model CustomerProfile {
  id               String   @id @default(uuid()) @db.Uuid
  customerId       String   @unique @map("customer_id") @db.Uuid
  company          Company  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  segment          String?
  size             String?
  status           String?
  source           String?
  sourceSpecify    String?  @map("source_specify")
  accountPotential String?  @map("account_potential")
  estimatedVolume  Int?     @map("estimated_volume")
  volumeUnit       String?  @map("volume_unit")
  currency         String?
  incoterms        String?
  mainRoutes       String?  @map("main_routes")
  cargoType        String?  @map("cargo_type")
  restrictions     String?
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("customer_profiles")
}

model Lead {
  id                     String    @id @default(uuid()) @db.Uuid
  customerId             String    @map("customer_id") @db.Uuid
  customer               Company   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactId              String?   @map("contact_id") @db.Uuid
  contact                Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  operatorId             String?   @map("operator_id") @db.Uuid
  operator               User?     @relation("LeadOperator", fields: [operatorId], references: [id])
  status                 String    @default("Novo")
  source                 String
  campaign               String?
  urgency                String
  score                  Int
  currency               String?
  modal                  String
  estimatedVolume        Int       @map("estimated_volume")
  volumeUnit             String    @map("volume_unit")
  painIdentified         String?   @map("pain_identified")
  interest               String?
  disqualificationReason String?   @map("disqualification_reason")
  lastInteractionAt      DateTime? @map("last_interaction_at")
  convertedAt            DateTime? @map("converted_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("leads")
}

/// Belongs to a Company (not to a single Lead) so the same person can be
/// reused across multiple leads — mirrors the standalone "Contatos" module.
model Contact {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  fullName    String    @map("full_name")
  extension   String?
  phoneNumber String?   @map("phone_number")
  workPhone   String?   @map("work_phone")
  email       String?
  pronoun     String?
  photo       String?
  birthday    DateTime? @db.Date
  language    String?   @default("Português")
  jobTitle    String?   @map("job_title")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  leads Lead[]

  @@map("contacts")
}

model Port {
  id          String   @id @default(uuid()) @db.Uuid
  portName    String?  @map("port_name")
  portCode    String?  @map("port_code")
  countryName String?  @map("country_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  loadShipments      Shipment[]       @relation("ShipmentPortLoad")
  dischargeShipments Shipment[]       @relation("ShipmentPortDischarge")
  depots             FlexitankDepot[]

  @@map("ports")
}

/// Minimal subset of the legacy `products` table — only what Flexitank details need.
model Product {
  id          String   @id @default(uuid()) @db.Uuid
  productName String?  @map("product_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shipments Shipment[]

  @@map("products")
}

model PurchaseOrder {
  id                  String    @id @default(uuid()) @db.Uuid
  poNumber            String?   @unique @map("po_number")
  poDate              DateTime? @map("po_date")
  /// URL/caminho do arquivo — sem upload real ainda (v1 não inclui integração de armazenamento)
  poFile              String?   @map("po_file")
  proformaNumber      String?   @map("proforma_number")
  proformaDate        DateTime? @map("proforma_date")
  proformaFile        String?   @map("proforma_file")
  packingListNumber   String?   @map("packing_list_number")
  packingListDate     DateTime? @map("packing_list_date")
  packingListFile     String?   @map("packing_list_file")
  blNumber            String?   @map("bl_number")
  blDate              DateTime? @map("bl_date")
  blFile              String?   @map("bl_file")
  tempAdmissionNumber String?   @map("temp_admission_number")
  tempAdmissionDate   DateTime? @map("temp_admission_date")
  tempAdmissionFile   String?   @map("temp_admission_file")
  arrivalDate         DateTime? @map("arrival_date")
  /// Presença desta data é o que deriva o status "Completed"/"Expected" (nunca armazenado)
  clearenceDate       DateTime? @map("clearence_date")
  observations        String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  flexitanks  Flexitank[]
  products    ProductPo[]
  accessories Accessory[]

  @@map("purchase_orders")
}

/// Itens/linhas de produto de uma Purchase Order — `isFlexitank` marca linhas cuja `quantity`
/// compõe a cota de flexitanks que podem ser cadastrados para a PO.
model ProductPo {
  id          String        @id @default(uuid()) @db.Uuid
  poId        String        @map("po_id") @db.Uuid
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Restrict)
  description String?
  quantity    Int
  price       Float?
  size        String?
  comments    String?
  isFlexitank Boolean       @default(false) @map("is_flexitank")
  userId      String?       @map("user_id") @db.Uuid
  user        User?         @relation(fields: [userId], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("products_po")
}

/// Acessórios vinculados a uma PO. Anti-Bulging Bars são cadastrados em kits (sem `code`
/// individual); os demais tipos (ex. Heating Pad) recebem um `code` sequencial único por unidade.
model Accessory {
  id              String        @id @default(uuid()) @db.Uuid
  type            String
  code            String?       @unique
  quantityKit     Int?          @map("quantity_kit")
  status          String        @default("Available")
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now()) @map("created_at")

  @@map("accessories")
}

/// Minimal subset of the legacy `shipments` table — only what Flexitank details need.
model Shipment {
  id               String    @id @default(uuid()) @db.Uuid
  booking          String?
  sslBookingNumber String?   @map("ssl_booking_number")
  customerId       String?   @map("customer_id") @db.Uuid
  customer         Company?  @relation("ShipmentCustomer", fields: [customerId], references: [id])
  shipperId        String?   @map("shipper_id") @db.Uuid
  shipper          Company?  @relation("ShipmentShipper", fields: [shipperId], references: [id])
  consigneeId      String?   @map("consignee_id") @db.Uuid
  consignee        Company?  @relation("ShipmentConsignee", fields: [consigneeId], references: [id])
  shippingLineId   String?   @map("shipping_line_id") @db.Uuid
  shippingLine     Company?  @relation("ShipmentShippingLine", fields: [shippingLineId], references: [id])
  productId        String?   @map("product_id") @db.Uuid
  product          Product?  @relation(fields: [productId], references: [id])
  portLoadId       String?   @map("port_load_id") @db.Uuid
  portLoad         Port?     @relation("ShipmentPortLoad", fields: [portLoadId], references: [id])
  portDischargeId  String?   @map("port_discharge_id") @db.Uuid
  portDischarge    Port?     @relation("ShipmentPortDischarge", fields: [portDischargeId], references: [id])
  vessel           String?
  voyage           String?
  etd              DateTime?
  atd              DateTime?
  eta              DateTime?
  ata              DateTime?
  mblNumber        String?   @map("mbl_number")
  hblNumber        String?   @map("hbl_number")
  status           String?
  /// Declared container quantity for the shipment (independent of itemized `containers` rows)
  quantity         Int?
  /// One of: Flexitank - Full Service, Flexitank - Supply & Fit, Flexitank - Supply Only,
  /// Isotank - Full Service, Isotank - Rental Only, General Cargo
  shipmentType     String?   @map("shipment_type")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  flexitanks Flexitank[]
  containers Container[]

  @@map("shipments")
}

/// Physical container/equipment linked to a Flexitank — origin of container, tara,
/// lacre, fitting and loading fields on the Flexitank details page.
model Container {
  id              String     @id @default(uuid()) @db.Uuid
  containerNumber String?    @map("container")
  tare            Int?
  seal            String?
  fitting         String?
  loading         String?
  netWeight       String?    @map("net_weight")
  flexitankId     String?    @map("flexitank_id") @db.Uuid
  flexitank       Flexitank? @relation(fields: [flexitankId], references: [id])
  shipmentId      String?    @map("shipment_id") @db.Uuid
  shipment        Shipment?  @relation(fields: [shipmentId], references: [id])
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@map("containers")
}

model Flexitank {
  id              String         @id @default(uuid()) @db.Uuid
  serialNumber    String         @map("serial_number")
  fhbStock        String?        @map("fhb_stock")
  size            String
  price           Float
  locationId      String?        @map("location_id") @db.Uuid
  location        Company?       @relation("FlexitankLocation", fields: [locationId], references: [id])
  purchaseOrderId String?        @map("purchase_order_id") @db.Uuid
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  shipmentId      String?        @map("shipment_id") @db.Uuid
  shipment        Shipment?      @relation(fields: [shipmentId], references: [id])
  comment         String?
  status          String         @default("Available")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  containers Container[]

  @@map("flexitanks")
}

/// Maps a warehouse/terminal Company to the Port it operates at — used to build
/// the Porto x Empresa inventory summary.
model FlexitankDepot {
  id        String   @id @default(uuid()) @db.Uuid
  portId    String?  @map("port_id") @db.Uuid
  port      Port?    @relation(fields: [portId], references: [id])
  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("flexitank_depot")
}

/// Personalização do dashboard por usuário: ordem, tamanho e visibilidade de cada card.
model DashboardLayout {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// DashboardLayoutItem[] — { id, order, size, visible }
  layout    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dashboard_layouts")
}
